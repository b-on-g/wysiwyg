$bog_wysiwyg $mol_view
	page_land_link \
	notice_too_long @ \That is more text than one block can hold, so it was not saved. Split it up.
	notice_image_failed @ \The picture could not be saved. Try again, or pick a smaller one.
	readonly false
	block_ids? /
	Block* $bog_wysiwyg_block
		html? <=> block_html*? \
		type? <=> block_type*? \paragraph
		level? <=> block_level*? 1
		readonly <= readonly
		menu_open <= menu_showed? false
		ai_open <= ai_showed? false
		on_enter?event <=> block_enter*?event null
		on_remove?event <=> block_remove*?event null
		on_split?parts <=> block_split*?parts null
		on_merge_prev?event <=> block_merge_prev*?event null
		on_merge_next?event <=> block_merge_next*?event null
		on_nav?nav <=> block_nav*?nav null
		on_input?event <=> block_input*?event null
		on_slash?event <=> block_slash*?event null
		on_menu_key?event <=> block_menu_key*?event null
		on_image?src <=> block_image*?src null
		on_image_file?file <=> block_image_file*?file null
		on_link?event <=> block_link*?event null
		on_ai?event <=> block_ai*?event null
		on_ai_key?event <=> block_ai_key*?event null
		on_paste_blocks?val <=> block_paste_blocks*?val null
	Block_row* $mol_view
		attr *
			bog_wysiwyg_drag_over <= row_is_drag_over* false
			bog_wysiwyg_drag_pos <= row_drag_position* \
			bog_wysiwyg_dragging <= row_is_dragging* false
		event *
			dragover?event <=> row_dragover*?event null
			drop?event <=> row_drop*?event null
			dragend?event <=> row_dragend*?event null
		sub <= block_row_sub* /
			<= Drag_handle* $mol_view
				attr *
					draggable \true
				event *
					dragstart?event <=> handle_dragstart*?event null
				sub /
					\⠿
			<= Block*
			<= Block_comment* $bog_wysiwyg_comment
				comment_land_link <= block_comment_land_link* \
				panel_open? <=> block_comment_open*? false
	drag_source_id? \
	drag_over_id? \
	drag_over_position? \after
	all_pages /
	event *
		^
		keydown?event <=> editor_keydown?event null
		copy?event <=> editor_copy?event null
	sub /
		<= Status $giper_baza_status
		<= Block_list $mol_list
			rows <= block_row_views /
		<= Backlinks $bog_wysiwyg_links
			page_id <= page_land_link
			all_pages <= all_pages
		<= Menu $bog_wysiwyg_menu
			showed? <=> menu_showed? false
			picked?val <=> menu_picked?val \
			index? <=> menu_index? 0
			pos_y <= menu_pos_y? 0
			pos_x <= menu_pos_x? 0
		<= Ai $bog_wysiwyg_ai
			showed? <=> ai_showed? false
			context <= ai_context? \
			loading? <=> ai_loading? false
			on_result?text <=> ai_result?text null
			picked?val <=> ai_picked?val \
			index? <=> ai_index? 0
			pos_y <= ai_pos_y? 0
			pos_x <= ai_pos_x? 0
		<= History $bog_wysiwyg_history
			page_land_link <= page_land_link
			showed? <=> history_showed? false
		<= Image_prompt $bog_wysiwyg_prompt
			showed <= image_prompt_showed? false
			pos_y <= prompt_pos_y? 0
			pos_x <= prompt_pos_x? 0
			file_shown true
			label @ \Picture: choose a file or paste an address
			hint \https://example.com/picture.png
			value?val <=> image_url?val \
			files? <=> image_files? /File
			submit? <=> image_submit? null
		<= Link_prompt $bog_wysiwyg_prompt
			showed <= link_prompt_showed? false
			pos_y <= prompt_pos_y?
			pos_x <= prompt_pos_x?
			label @ \Link address
			hint \https://example.com
			value?val <=> link_url?val \
			submit? <=> link_submit? null
		<= Notice $mol_button_minor
			title <= notice? \
			click? <=> notice_dismiss? null
			attr *
				^
				bog_wysiwyg_notice_showed <= notice_showed false
