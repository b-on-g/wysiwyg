$bog_wysiwyg_export $mol_pick
	blocks /$bog_wysiwyg_export_block
	page_title \
	tags /string
	cover \
	base_uri \https://baza.87.120.36.150.ip.giper.dev/
	dialect? \common
	images_apart? false
	part? \0
	part_current? \0
	markdown \
	markdown_shown \
	note \
	label_image @ \Image
	label_images @ \Images
	note_length @ \Length
	note_parts @ \Messages
	hint @ \Export to Markdown
	trigger_content /
		<= Trigger_icon $mol_icon_export
	bubble_content /
		<= Head $mol_view
			sub /
				<= Dialect $mol_select
					value? <=> dialect?
					hint @ \Target
					dictionary <= dialect_options *
						common @ \Markdown (GFM)
						habr @ \Habr
						devto @ \dev.to
						telegram @ \Telegram
				<= Images_apart $mol_check_box
					title @ \Images apart
					hint @ \List every image at the end instead of inlining it
					checked? <=> images_apart?
				<= Copy $mol_button_copy
					title @ \Copy
					hint @ \Copy markdown to clipboard
					text <= markdown_shown
		<= Note $mol_paragraph
			title <= note
		<= Parts $mol_select
			value? <=> part_current?
			hint @ \Message
			dictionary <= part_options *
		<= Body $mol_scroll
			sub /
				<= Output $mol_text_code
					text <= markdown_shown
					sidebar_showed false
